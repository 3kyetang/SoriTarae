# Server-side only. Never expose this value through a NEXT_PUBLIC_ variable.
GEMINI_API_KEY=your_gemini_api_key_here

# Public project identifiers. Database access is protected with Supabase RLS.
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key

# Server-to-server embedding connection. Never add a NEXT_PUBLIC_ prefix.
EMBEDDING_SERVICE_URL=http://127.0.0.1:8001
EMBEDDING_SERVICE_TOKEN=replace_with_at_least_32_random_characters
